# Postgres (Vercel Postgres / Neon). Pooled URL for the app, direct URL for prisma db push.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Random string of at least 32 characters; signs the login cookie.
SESSION_SECRET="change-me-to-a-long-random-string"

# The admin account is defined here, not in the database.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# OpenRouter key for generating candidate translations from the admin panel (optional).
OPENROUTER_API_KEY=""
